# ==============================================
# BFF Financial Security - Environment Variables
# ==============================================

# ============== Keycloak Configuration ==============
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=financial-banking
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# BFF Client (Confidential)
KEYCLOAK_BFF_CLIENT_ID=bff-banking
KEYCLOAK_BFF_CLIENT_SECRET=bff-secret-change-in-production

# Frontend Client (Public)
KEYCLOAK_FRONTEND_CLIENT_ID=frontend-banking

# Service Accounts
KEYCLOAK_SALDO_CLIENT_ID=saldo-service
KEYCLOAK_SALDO_CLIENT_SECRET=saldo-secret

KEYCLOAK_USUARIO_CLIENT_ID=usuario-service
KEYCLOAK_USUARIO_CLIENT_SECRET=usuario-secret

KEYCLOAK_PRESTAMOS_CLIENT_ID=prestamos-service
KEYCLOAK_PRESTAMOS_CLIENT_SECRET=prestamos-secret

KEYCLOAK_TARJETAS_CLIENT_ID=tarjetas-service
KEYCLOAK_TARJETAS_CLIENT_SECRET=tarjetas-secret

# ============== Database Configuration ==============

# Saldo Database
POSTGRES_SALDO_HOST=postgres-saldo
POSTGRES_SALDO_PORT=5432
POSTGRES_SALDO_DB=saldo_db
POSTGRES_SALDO_USER=saldo_user
POSTGRES_SALDO_PASSWORD=saldo_pass_change_in_production

# Usuario Database
POSTGRES_USUARIO_HOST=postgres-usuario
POSTGRES_USUARIO_PORT=5432
POSTGRES_USUARIO_DB=usuario_db
POSTGRES_USUARIO_USER=usuario_user
POSTGRES_USUARIO_PASSWORD=usuario_pass_change_in_production

# Préstamos Database
POSTGRES_PRESTAMOS_HOST=postgres-prestamos
POSTGRES_PRESTAMOS_PORT=5432
POSTGRES_PRESTAMOS_DB=prestamos_db
POSTGRES_PRESTAMOS_USER=prestamos_user
POSTGRES_PRESTAMOS_PASSWORD=prestamos_pass_change_in_production

# Tarjetas Database
POSTGRES_TARJETAS_HOST=postgres-tarjetas
POSTGRES_TARJETAS_PORT=5432
POSTGRES_TARJETAS_DB=tarjetas_db
POSTGRES_TARJETAS_USER=tarjetas_user
POSTGRES_TARJETAS_PASSWORD=tarjetas_pass_change_in_production

# ============== Microservices URLs ==============
SALDO_SERVICE_URL=https://saldo-service:3001
USUARIO_SERVICE_URL=https://usuario-service:3002
PRESTAMOS_SERVICE_URL=https://prestamos-service:3003
TARJETAS_SERVICE_URL=https://tarjetas-service:3004

# ============== BFF Configuration ==============
BFF_PORT=4000
BFF_HOST=0.0.0.0
NODE_ENV=development

# Security
BFF_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
BFF_RATE_LIMIT_MAX_REQUESTS=100   # 100 requests per window
BFF_CIRCUIT_BREAKER_THRESHOLD=0.5  # 50% error rate
BFF_CIRCUIT_BREAKER_TIMEOUT=5000   # 5 seconds
BFF_REQUEST_TIMEOUT=10000          # 10 seconds

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json # json, simple

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============== mTLS Certificates ==============
BFF_CERT_PATH=/app/certs/bff.crt
BFF_KEY_PATH=/app/certs/bff.key
BFF_CA_PATH=/app/certs/ca.crt

SALDO_SERVICE_CERT_PATH=/app/certs/saldo.crt
SALDO_SERVICE_KEY_PATH=/app/certs/saldo.key
SALDO_SERVICE_CA_PATH=/app/certs/ca.crt

USUARIO_SERVICE_CERT_PATH=/app/certs/usuario.crt
USUARIO_SERVICE_KEY_PATH=/app/certs/usuario.key
USUARIO_SERVICE_CA_PATH=/app/certs/ca.crt

PRESTAMOS_SERVICE_CERT_PATH=/app/certs/prestamos.crt
PRESTAMOS_SERVICE_KEY_PATH=/app/certs/prestamos.key
PRESTAMOS_SERVICE_CA_PATH=/app/certs/ca.crt

TARJETAS_SERVICE_CERT_PATH=/app/certs/tarjetas.crt
TARJETAS_SERVICE_KEY_PATH=/app/certs/tarjetas.key
TARJETAS_SERVICE_CA_PATH=/app/certs/ca.crt

# ============== Frontend Configuration ==============
VITE_BFF_URL=http://localhost:4000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=financial-banking
VITE_KEYCLOAK_CLIENT_ID=frontend-banking
